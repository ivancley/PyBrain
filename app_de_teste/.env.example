# Copie para app_de_teste/.env (ignorado pelo git) e preencha a chave.
OPENROUTER_API_KEY=sk-or-...

# Modelo que conversa. Qualquer id de https://openrouter.ai/models
OPENROUTER_MODELO=openai/gpt-4o-mini
# Modelo que extrai fatos para a memória (padrão: o mesmo de cima)
# OPENROUTER_MODELO_EXTRATOR=openai/gpt-4o-mini

# Embeddings: "openrouter" (padrão) ou "falso" (sem rede; a busca perde a semântica)
EMBEDDINGS=openrouter
OPENROUTER_MODELO_EMBEDDING=openai/text-embedding-3-small
OPENROUTER_DIMENSAO_EMBEDDING=1536

# Banco: o mesmo Postgres + pgvector da suíte (make db-up)
CHAT_DATABASE_URL=postgresql://memory:memory@localhost:5433/memory_lifecycle
# A dimensão fica gravada no schema; mudou de modelo de embedding, mude o schema.
MEMORIA_SCHEMA=chat_teste
MEMORIA_TENANT=app-de-teste
